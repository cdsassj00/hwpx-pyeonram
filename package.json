{
  "name": "cdsa-hwptemp",
  "version": "1.1.0",
  "description": "정부·공공기관 서식(행정업무운영 편람, 업무보고, 지침, 강의계획서, 자문의견서, 제안서, 공모안)으로 HWPX(한글) 문서를 생성하는 CLI/라이브러리. 서식별 정품 header.xml 백본으로 한글 호환성 100%.",
  "keywords": [
    "hwpx",
    "hwp",
    "hancom",
    "hangul",
    "한글",
    "편람",
    "행정업무운영편람",
    "행정안전부",
    "공문서",
    "gov",
    "korean-government",
    "document-generator"
  ],
  "license": "MIT",
  "bin": {
    "cdsa-hwptemp": "bin/cli.js"
  },
  "main": "src/generate.js",
  "exports": {
    ".": "./src/generate.js"
  },
  "files": [
    "bin/",
    "src/",
    "templates/",
    "tools/",
    "examples/",
    "test/",
    "README.md",
    "SKILL.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.js",
    "example": "node bin/cli.js examples/sample.md -o examples/sample.hwpx"
  },
  "engines": {
    "node": ">=14"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cdsassj00/cdsa-hwptemp.git"
  },
  "author": "CDSA (한국데이터사이언티스트협회)",
  "dependencies": {}
}
